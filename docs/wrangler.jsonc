{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "csp-docs",
  "compatibility_date": "2026-09-05",
  // Static-assets Worker: `astro build` writes the site to ./dist and
  // `wrangler deploy` uploads it. No Worker script runs on the hot path.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Custom domain declared as the repository homepage. Requires the
  // `pleaseai.dev` zone in the deploying Cloudflare account; Wrangler
  // creates the DNS record and certificate on first deploy.
  "routes": [
    { "pattern": "code-search.pleaseai.dev", "custom_domain": true }
  ]
}
