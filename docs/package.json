{
  "name": "@pleaseai/csp-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for csp (Code Search Please), built with Cloudflare Nimbus and deployed as Cloudflare Workers static assets.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check": "nimbus-docs check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "prepreview:cf": "astro build",
    "preview:cf": "wrangler pages dev",
    "predeploy": "astro check && astro build",
    "deploy": "wrangler pages deploy"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.12.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "astro": "~7.0.9",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.41.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@tailwindcss/vite": "^4.1.4",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.95.0"
  }
}
